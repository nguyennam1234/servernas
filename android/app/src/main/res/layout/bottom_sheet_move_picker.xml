<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#d0d5dd"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="14dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/txtMoveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Di chuyển tệp"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/btnMoveClose"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_onedrive_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/btnMoveParent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:id="@+id/txtMoveCurrentPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Drive của tôi"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbMoveLoading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/primary_container"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMoveFolders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/txtMoveEmpty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Thư mục này chưa có thư mục con\10Bấm nút bên dưới để di chuyển vào đây"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/primary"
            android:id="@+id/btnMoveNewFolder"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Thư mục mới"
            app:icon="@drawable/ic_folder_new"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/fluent_white"
            android:id="@+id/btnMoveConfirm"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Di chuyển vào đây"
            android:backgroundTint="@color/primary"/>
    </LinearLayout>
</LinearLayout>
