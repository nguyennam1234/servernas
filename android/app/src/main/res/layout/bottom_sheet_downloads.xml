<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#d0d5dd"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tệp đã tải về máy"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/btnRefreshDownloads"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_secondary"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Thư mục Download trên thiết bị - Bấm video để phát offline"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDownloadedFiles"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:id="@+id/txtEmptyDownloads"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="Chưa có tệp tin nào được tải về máy"/>
</LinearLayout>
