<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#d2d0ce"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/bg_hud_badge"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:backgroundTint="@color/fluent_blue">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NN"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/fluent_neutral_dark"
                android:id="@+id/txtMeUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Nam (NAS Drive)"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/fluent_neutral_secondary"
                android:id="@+id/txtMeServerIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="http://192.168.88.230:8080"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imgMeVerified"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_fluent_checkmark_24_regular"
            app:tint="@color/fluent_green"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/fluent_neutral_lighter"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/fluent_neutral_light"
        app:strokeWidth="1dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_fluent_folder_24_filled"
                    app:tint="@color/fluent_blue"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_neutral_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Bộ lưu trữ NAS cá nhân"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_blue"
                    android:id="@+id/txtMePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9%"/>
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbMeStorage"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:progress="9"
                app:indicatorColor="@color/fluent_blue"
                app:trackColor="@color/fluent_neutral_light"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/fluent_neutral_secondary"
                android:id="@+id/txtMeStorageDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đã dùng 55.1 GB trên 589.5 GB"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnMeVault"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/fluent_blue"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/fluent_neutral_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Thư mục bí mật (AES-256)"
                android:layout_weight="1"
                android:layout_marginStart="14dp"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fluent_neutral_tertiary"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnMeRecycleBin"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fluent_bin_recycle_24_regular"
                app:tint="@color/fluent_neutral_secondary"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/fluent_neutral_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Thùng rác"
                android:layout_weight="1"
                android:layout_marginStart="14dp"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fluent_neutral_tertiary"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnMeServerSettings"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fluent_settings_24_regular"
                app:tint="@color/fluent_neutral_secondary"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/fluent_neutral_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cài đặt địa chỉ máy chủ &amp; DDNS"
                android:layout_weight="1"
                android:layout_marginStart="14dp"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fluent_neutral_tertiary"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnMeClearCache"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/fluent_neutral_secondary"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/fluent_neutral_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Xóa bộ nhớ đệm ảnh / thumbnail"
                android:layout_weight="1"
                android:layout_marginStart="14dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/fluent_neutral_tertiary"
                android:id="@+id/txtMeCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sạch"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/fluent_neutral_tertiary"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Microsoft OneDrive Mobile Architecture • v7.66.89"/>
</LinearLayout>
