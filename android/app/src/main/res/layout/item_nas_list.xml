<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#f3f2f1"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imgListThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgListTypeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_fluent_folder_24_filled"
                app:tint="@color/fluent_amber"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgListPlayBadge"
                android:background="@drawable/bg_hud_badge"
                android:padding="3dp"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_fluent_play_circle_24_filled"
                app:tint="#ffffff"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/txtListName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên tệp tin.mp4"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/txtListMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="5.9 MB • 19:55 30/10/2026"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/btnListMore"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_fluent_more_vertical_24_regular"
        android:contentDescription="Tùy chọn"
        app:tint="@color/text_secondary"/>
</LinearLayout>
