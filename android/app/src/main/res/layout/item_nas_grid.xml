<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="#f3f2f1"
            android:layout_width="match_parent"
            android:layout_height="130dp">
            <ImageView
                android:id="@+id/imgGridThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgTypeIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_fluent_folder_24_filled"
                app:tint="@color/fluent_amber"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imgPlayBadge"
                android:background="@drawable/bg_hud_badge"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_fluent_play_circle_24_filled"
                app:tint="#ffffff"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="end|bottom"
                android:id="@+id/txtGridBadge"
                android:background="@drawable/bg_hud_badge"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:id="@+id/txtGridName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên tệp tin"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/txtGridMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="14.5 MB • 20:30"
                    android:singleLine="true"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnGridMore"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_fluent_more_vertical_24_regular"
                android:contentDescription="Tùy chọn"
                app:tint="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
