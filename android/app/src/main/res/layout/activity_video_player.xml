<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootView"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false"/>
    <View
        android:id="@+id/gestureTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_gravity="center"
        android:id="@+id/bufferingProgress"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminate="true"
        app:indicatorColor="#ffffff"
        app:trackColor="#4dffffff"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/hudBrightness"
        android:background="@drawable/bg_hud_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_brightness"
            app:tint="#ffffff"/>
        <ProgressBar
            android:id="@+id/pbBrightness"
            android:layout_width="80dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#ffeb3b"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/txtBrightnessValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/hudVolume"
        android:background="@drawable/bg_hud_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_volume"
            app:tint="#ffffff"/>
        <ProgressBar
            android:id="@+id/pbVolume"
            android:layout_width="80dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="70"
            android:progressTint="#2196f3"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/txtVolumeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="70%"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/hudSeek"
        android:background="@drawable/bg_hud_badge"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/txtSeekDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+00:15"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#b0ffffff"
            android:id="@+id/txtSeekTargetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="02:30 / 10:15"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/doubleTapLeft"
        android:background="@drawable/bg_hud_badge"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="⏪ 10s"
        android:layout_marginStart="40dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/doubleTapRight"
        android:background="@drawable/bg_hud_badge"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="10s ⏩"
        android:layout_marginEnd="40dp"/>
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/topBar"
            android:background="@drawable/bg_gradient_top"
            android:paddingTop="28dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                app:tint="#ffffff"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="marquee"
                    android:id="@+id/txtVideoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên video"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#81c784"
                    android:id="@+id/txtServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="⚡ LAN 1Gbps"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnSpeed"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:text="1.0x"
                android:paddingHorizontal="8dp"
                style="@style/Widget.Material3.Button.TextButton"/>
            <ImageButton
                android:id="@+id/btnAspectRatio"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_aspect_ratio"
                android:contentDescription="Tỉ lệ"
                app:tint="#ffffff"/>
            <ImageButton
                android:id="@+id/btnPip"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_pip"
                android:contentDescription="Thu nhỏ"
                app:tint="#ffffff"/>
            <ImageButton
                android:id="@+id/btnDownload"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_download"
                android:contentDescription="Tải xuống"
                app:tint="#ffffff"/>
            <ImageButton
                android:id="@+id/btnShare"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Chia sẻ"
                app:tint="#ffffff"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/btnRewind10"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_replay_10"
                android:contentDescription="Tua lại 10s"
                android:layout_marginEnd="32dp"
                app:tint="#ffffff"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnPlayPauseCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Phát/Tạm dừng"
                app:backgroundTint="#e62196f3"
                app:elevation="6dp"
                app:fabCustomSize="68dp"
                app:maxImageSize="36dp"
                app:tint="#ffffff"/>
            <ImageButton
                android:id="@+id/btnForward10"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_forward_10"
                android:contentDescription="Tua tới 10s"
                android:layout_marginStart="32dp"
                app:tint="#ffffff"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottomBar"
            android:background="@drawable/bg_gradient_bottom"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/txtCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"/>
                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxHeight="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:progressTint="#2196f3"
                    android:secondaryProgressTint="#662196f3"
                    android:thumbTint="#2196f3"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#b0ffffff"
                    android:id="@+id/txtTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <ImageButton
                    android:id="@+id/btnLockScreen"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_lock_open"
                    android:contentDescription="Khóa màn hình"
                    app:tint="#ffffff"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/txtAspectModeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Vừa khung hình"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
                <ImageButton
                    android:id="@+id/btnOrientation"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_rotate"
                    android:contentDescription="Xoay màn hình"
                    app:tint="#ffffff"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="start|top"
        android:id="@+id/btnFloatingUnlock"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="Mở khóa"
        android:layout_marginStart="24dp"
        app:backgroundTint="#cc1e1e1e"
        app:fabCustomSize="48dp"
        app:tint="#ff5252"/>
</FrameLayout>
