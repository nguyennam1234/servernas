<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="1dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp">
            <FrameLayout
                android:id="@+id/btnHeaderAvatar"
                android:background="@drawable/bg_hud_badge"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/fluent_blue">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="NN"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_onedrive_search"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_fluent_search_24_regular"
                    app:tint="@color/fluent_neutral_secondary"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/fluent_neutral_dark"
                    android:textColorHint="@color/fluent_neutral_secondary"
                    android:id="@+id/edtSearch"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="Tìm kiếm trong OneDrive"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:layout_marginStart="8dp"/>
                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/fluent_neutral_secondary"/>
                <ImageView
                    android:id="@+id/btnQuickScan"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_fluent_camera_24_regular"
                    android:layout_marginStart="6dp"
                    app:tint="@color/fluent_blue"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chipServerBadge"
                android:background="@drawable/bg_server_badge"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp">
                <View
                    android:id="@+id/serverStatusDot"
                    android:background="@drawable/bg_hud_badge"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:backgroundTint="@color/fluent_green"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_neutral_dark"
                    android:id="@+id/txtServerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAN"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingHorizontal="14dp">
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/breadcrumbsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </HorizontalScrollView>
            <ImageButton
                android:id="@+id/btnSort"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_fluent_arrow_sort_24_regular"
                android:contentDescription="Sắp xếp"
                app:tint="@color/fluent_neutral_secondary"/>
            <ImageButton
                android:id="@+id/btnToggleViewMode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_fluent_list_24_regular"
                android:contentDescription="Đổi dạng xem"
                android:layout_marginStart="4dp"
                app:tint="@color/fluent_neutral_secondary"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/storageContainer"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/fluent_neutral_secondary"
                    android:id="@+id/txtStorageLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="☁️ Đã dùng 55.1 GB / 589.5 GB"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_blue"
                    android:id="@+id/txtStoragePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9%"/>
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/storageProgressBar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:progress="9"
                app:indicatorColor="@color/fluent_blue"
                app:trackColor="@color/fluent_neutral_light"/>
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pageProgressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="true"
            app:indicatorColor="@color/fluent_blue"
            app:trackColor="@color/fluent_neutral_light"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="80dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:padding="6dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/emptyStateView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_fluent_folder_24_regular"
                app:tint="@color/fluent_neutral_tertiary"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fluent_neutral_dark"
                android:id="@+id/txtEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Thư mục trống"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/fluent_neutral_secondary"
                android:id="@+id/txtEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nhấn nút (+) bên dưới để tải lên tệp hoặc tạo thư mục"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyRetry"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Làm mới"
                app:icon="@drawable/ic_refresh"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/uploadProgressCard"
            android:background="@drawable/bg_upload_card"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="80dp"
            android:elevation="6dp"
            android:layout_marginHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_neutral_dark"
                    android:ellipsize="middle"
                    android:id="@+id/txtUploadFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Đang tải tệp lên…"
                    android:singleLine="true"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/fluent_green"
                    android:id="@+id/txtUploadSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 48.2 MB/s"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/pbUploadProgress"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/fluent_blue"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/btnFabMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="88dp"
            android:src="@drawable/ic_fluent_add_24_regular"
            android:contentDescription="Tạo hoặc tải lên"
            android:layout_marginEnd="18dp"
            app:backgroundTint="@color/fluent_blue"
            app:elevation="4dp"
            app:fabSize="normal"
            app:tint="#ffffff"/>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_gravity="bottom"
            android:id="@+id/bottomNavigationView"
            android:background="@color/surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="8dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/selector_fluent_nav"
            app:itemPaddingBottom="10dp"
            app:itemPaddingTop="10dp"
            app:itemTextColor="@color/selector_fluent_nav"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_onedrive_nav"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
