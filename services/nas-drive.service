[Unit]
Description=Google Drive NAS 600GB Storage Service
After=network.target mnt-nas.mount
Wants=network.target

[Service]
Type=simple
User=nguyennam
Group=nguyennam
WorkingDirectory=/home/nguyennam/nas-drive/backend
ExecStart=/usr/bin/node /home/nguyennam/nas-drive/backend/server.mjs
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=STORAGE_ROOT=/mnt/nas/drive

[Install]
WantedBy=multi-user.target
