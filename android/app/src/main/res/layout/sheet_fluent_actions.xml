<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#d2d0ce"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/fluent_neutral_dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Tạo &amp; Tải lên"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actScanCamera"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_fluent_camera_24_regular"
            app:tint="@color/fluent_blue"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fluent_neutral_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Quét tài liệu / Chụp ảnh"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actUploadMedia"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_fluent_album_24_regular"
            app:tint="@color/fluent_blue"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fluent_neutral_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tải lên ảnh hoặc video"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actNewFolder"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_fluent_folder_24_regular"
            app:tint="@color/fluent_amber"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fluent_neutral_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tạo thư mục mới"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actUploadFile"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_file"
            app:tint="@color/fluent_neutral_secondary"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fluent_neutral_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tải lên tệp tin"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</LinearLayout>
